# Visual Studio 2015 user specific files
LEGame/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
LEGame/SourceArt/**/*.png
LEGame/SourceArt/**/*.tga

# Binary Files
LEGame/Binaries/*
LEGame/Plugins/**/Binaries/*

# Builds
LEGame/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!LEGame/Build/*/
LEGame/Build/*/**
!LEGame/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!LEGame/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
LEGame/Saved/*

# Compiled source files for the engine to use
LEGame/Intermediate/*
LEGame/Plugins/**/Intermediate/*

# Cache files for the editor to use
LEGame/DerivedDataCache/*
LEGame/.idea
